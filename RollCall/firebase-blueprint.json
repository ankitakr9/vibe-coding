{
  "entities": {
    "UserAccount": {
      "title": "UserAccount",
      "description": "Authenticated user account with role-based access control metadata (no PII stored on root doc).",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "role": {
          "type": "string",
          "enum": ["admin", "faculty", "student"]
        },
        "department": {
          "type": "string",
          "maxLength": 80
        },
        "memberCode": {
          "type": "string",
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9_\\-]*$"
        },
        "status": {
          "type": "string",
          "enum": ["active", "inactive"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "role", "department", "memberCode", "status", "createdAt", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Isolated PII subcollection document for an authenticated user (email, phone).",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "maxLength": 160
        },
        "phone": {
          "type": "string",
          "maxLength": 30
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "phone", "updatedAt"]
    },
    "RosterMember": {
      "title": "RosterMember",
      "description": "Institutional directory record for a student or faculty member managed by Admin.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fullName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "memberCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "role": {
          "type": "string",
          "enum": ["student", "faculty"]
        },
        "department": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "batchOrTitle": {
          "type": "string",
          "maxLength": 80
        },
        "status": {
          "type": "string",
          "enum": ["active", "inactive"]
        },
        "linkedUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]*$"
        },
        "assignedFacultyUids": {
          "type": "array",
          "description": "Bounded list (max 20) of faculty UIDs authorized to view and mark attendance for this roster member."
        },
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "fullName", "memberCode", "role", "department", "batchOrTitle", "status", "linkedUid", "assignedFacultyUids", "createdBy", "createdAt", "updatedAt"]
    },
    "RosterPrivateContact": {
      "title": "RosterPrivateContact",
      "description": "Admin-isolated PII contact record for a roster member.",
      "type": "object",
      "properties": {
        "memberId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "maxLength": 160
        },
        "phone": {
          "type": "string",
          "maxLength": 30
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["memberId", "email", "phone", "updatedAt"]
    },
    "Course": {
      "title": "Course",
      "description": "Academic course or workplace cohort tracked for daily attendance.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "code": {
          "type": "string",
          "minLength": 2,
          "maxLength": 24,
          "pattern": "^[a-zA-Z0-9_\\- ]+$"
        },
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "department": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "semester": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "schedule": {
          "type": "string",
          "maxLength": 80
        },
        "facultyMemberId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]*$"
        },
        "facultyName": {
          "type": "string",
          "maxLength": 100
        },
        "facultyUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]*$"
        },
        "status": {
          "type": "string",
          "enum": ["active", "archived"]
        },
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "code", "title", "department", "semester", "schedule", "facultyMemberId", "facultyName", "facultyUid", "status", "createdBy", "createdAt", "updatedAt"]
    },
    "AttendanceRecord": {
      "title": "AttendanceRecord",
      "description": "Individual student attendance entry for a course on a specific ISO date.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "courseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "courseCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24
        },
        "courseTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "studentMemberId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "studentName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "studentCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "studentUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]*$"
        },
        "facultyUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]*$"
        },
        "date": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "status": {
          "type": "string",
          "enum": ["present", "absent", "late", "excused"]
        },
        "remarks": {
          "type": "string",
          "maxLength": 300
        },
        "markedByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "markedByName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "locked": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "courseId", "courseCode", "courseTitle", "studentMemberId", "studentName", "studentCode", "studentUid", "facultyUid", "date", "status", "remarks", "markedByUid", "markedByName", "locked", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserAccount" },
      "description": "Authenticated user role and academic profile (strictly PII-free)."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Isolated PII subcollection strictly restricted to owner or admin."
    },
    "/roster/{memberId}": {
      "schema": { "$ref": "#/entities/RosterMember" },
      "description": "Institutional student and faculty directory managed by admins."
    },
    "/roster/{memberId}/private/{docId}": {
      "schema": { "$ref": "#/entities/RosterPrivateContact" },
      "description": "Admin-only contact PII for roster members."
    },
    "/courses/{courseId}": {
      "schema": { "$ref": "#/entities/Course" },
      "description": "Courses and classes monitored for attendance."
    },
    "/attendance/{recordId}": {
      "schema": { "$ref": "#/entities/AttendanceRecord" },
      "description": "Attendance records linked to valid courses and roster students."
    }
  }
}
